# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database
DATABASE_URL='file:./dev.db'
# For PostgreSQL:
# DATABASE_URL='postgresql://user:password@localhost:5432/finance_aggregator?schema=public'

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Virtual Bank API
VIRTUAL_BANK_API_URL=http://161.97.158.103:8030
VIRTUAL_BANK_API_TIMEOUT=30000

# Currency API (for real exchange rates - optional)
# Get your free API key from: https://www.exchangerate-api.com/
CURRENCY_API_KEY=your-currency-api-key
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest

# Default Settings
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US

# Logging
LOG_LEVEL=debug
LOG_FORMAT=combined

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
